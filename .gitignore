# Tests: commit the hermetic pytest suite.
# NOTE: a bare directory rule (exam_analyzer/tests) would ignore the whole tree,
# and a directory-level exclusion makes every "!" whitelist below a no-op.
exam_analyzer/tests/*
!exam_analyzer/tests/*.py
# Manual scripts — require real API keys / local DB / local PDFs: keep OUT of git
exam_analyzer/tests/test_reachability.py
exam_analyzer/tests/_manual_suite.py

